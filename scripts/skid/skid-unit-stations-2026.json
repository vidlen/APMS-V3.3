  "schema_version": 1,
  "purpose": "Batas stasiun sample unit yang dipakai saat membuat skid-06-24-2026.json dan skid-07L-25R-2026.json. Dibaca oleh scripts/skid/build-skid-1m.mjs supaya data per meter memakai batas unit yang sama persis dengan data per unit.",
  "source": "Poligon public/data/runway-06-24-units-2026.json dan runway-07L-25R-units-2026.json di repo vidlen/APMS-v3.4 commit cb866d2. RWY 07L/25R dinomori ulang (unit = 361 - nomor di repo) agar unit 1 di ujung 25R, sama dengan web. Stasiun diukur sepanjang sumbu runway dari tepi luar unit 1.",
  "rules": {
    "station": "stasiun bacaan = s0_m lajur - DISTANCE (arah uji menuju unit 1). s0_m dibaca dari lanes[].s0_m di JSON per unit.",
    "unit_assignment": "bacaan masuk unit k jika starts_m[k] <= stasiun < starts_m[k+1]; unit terakhir: stasiun < last_end_m. Pakai nilai presisi penuh di berkas ini, jangan station_start_m di JSON per unit (sudah dibulatkan 2 desimal).",
    "window_152m": "mu_152m unit k = rata-rata bacaan lajur itu dengan window_mid_m[k] - 76.2 <= stasiun < window_mid_m[k] + 76.2. Bandingkan sebagai bilangan bulat 0,1 mm (Math.round(nilai * 10000)) supaya bacaan yang tepat di tepi jendela diperlakukan sama di semua mesin. Enam pasangan unit-lajur punya bacaan tepat di tepi: 06-24 unit 114 (L6.0, L1.5, R3.0, R6.0), 07L-25R unit 192 (R3.0) dan 240 (R4.5)."
  },
  "verification": {
    "starts_vs_station_start_m": "starts_m dibulatkan 3 desimal lalu 2 desimal sama dengan station_start_m di JSON per unit: 300/300 dan 360/360. Pembulatan langsung ke 2 desimal bisa berbeda 0,01 di beberapa unit; itu wajar.",
    "window_mid_vs_station_mid_m": "window_mid_m = rata-rata dua batas unit yang dibulatkan 3 desimal; dibulatkan 2 desimal sama dengan station_mid_m di JSON per unit: 300/300 dan 360/360",
    "reading_counts": "jumlah bacaan per unit per lajur dari aturan di atas (DISTANCE 1..LENGTH) sama dengan n di JSON per unit: 2400/2400 dan 2880/2880 pasangan unit-lajur"
  },
